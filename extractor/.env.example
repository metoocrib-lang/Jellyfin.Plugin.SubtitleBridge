# Copy as extractor/.env; NEVER commit .env, session cookies or credentials.
# Episode URL obtained from Disney+ browser address bar.
DISNEY_EPISODE_URL=https://www.disneyplus.com/play/REPLACE_WITH_EPISODE
SUBTITLE_LANGUAGE=es
LOGIN_GRACE_SECONDS=120
# Use once initially to confirm a correct SRT before enabling import.
UPLOAD_TO_BAZARR=false
# Sonarr numeric IDs for one known episode.
SONARR_SERIES_ID=0
SONARR_EPISODE_ID=0
# Bazarr address reachable FROM the agent container.
BAZARR_URL=http://host.docker.internal:6767
BAZARR_API_KEY=
# Only for the noVNC screen. Do NOT reuse streaming service passwords.
VNC_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
